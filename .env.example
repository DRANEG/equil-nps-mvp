# ---------------------------------------------------------------- aplicație ---
# Portul pe care asculta serverul
PORT=3000

# Parola pentru /admin. OBLIGATORIU de schimbat inainte de productie.
ADMIN_TOKEN=schimba-ma

# Fisierul SQLite (se creeaza automat)
NPS_DB=./data/nps.db

# URL-ul public al aplicatiei, folosit in linkurile din emailuri
PUBLIC_URL=http://localhost:3000

# --------------------------------------------------------------------- email ---
# Fara SMTP_HOST aplicatia NU trimite nimic: scrie emailurile ca fisiere .eml in
# data/outbox, ca sa le poti verifica inainte de a le da drumul catre clienti.
SMTP_HOST=
SMTP_PORT=587
# starttls (587, uzual), tls (465) sau none (doar pentru teste locale)
SMTP_SECURE=starttls
SMTP_USER=
SMTP_PASS=

# Expeditorul. Domeniul trebuie sa aiba SPF si DKIM, altfel mesajele ajung in spam.
MAIL_FROM=Equil <nps@firma-ta.ro>
MAIL_REPLY_TO=contact@firma-ta.ro
MAIL_BRAND=Equil

# ------------------------------------------------------------------- robotul ---
# Zile de asteptare inainte de singura reamintire
REMINDER_DAYS=5
# Rastimp intre importul contactelor si prima trimitere (timp de corectat lista)
SEND_DELAY_MINUTES=10
# Cat de des verifica robotul daca are ceva de trimis
SEND_INTERVAL_MINUTES=15
# Cate emailuri trimite intr-o singura trecere
SEND_BATCH_SIZE=50
# Pauza intre doua emailuri, ca sa nu te limiteze furnizorul
SEND_THROTTLE_MS=250
# SEND_ENABLED=0 opreste complet robotul (daca preferi cron: npm run trimite)
SEND_ENABLED=1

# Programul in care robotul are voie sa trimita (ora Romaniei)
SEND_HOURS=9-20
# Sari peste weekend si peste sarbatorile legale din Romania (1 = da)
SEND_SKIP_WEEKENDS=1
SEND_SKIP_HOLIDAYS=1

# ------------------------------------------------------------ formate locale ---
# Fusul orar si limba folosite la afisare (datele se stocheaza tot in UTC)
TIMEZONE=Europe/Bucharest
LOCALE=ro-RO
# Separatorul din exportul CSV (Excel romanesc asteapta ";")
CSV_SEPARATOR=;

# ------------------------------------------------------- alerte la detractori ---
# Adresele care primesc alerta imediat ce cineva da 0-6 (separate prin virgula).
ALERT_EMAILS=

# Notificare pe telefon prin Slack, Telegram sau Zapier. Exemple:
#   Slack:    https://hooks.slack.com/services/XXX/YYY/ZZZ
#   Telegram: https://api.telegram.org/bot<TOKEN>/sendMessage?chat_id=<ID>
ALERT_WEBHOOK_URL=

# Alerteaza pentru orice scor <= aceasta valoare (6 = toti detractorii)
ALERT_MAX_SCORE=6
# Plasa de siguranta: cel mult atatea alerte pe ora (restul raman in /admin/alerte)
ALERT_MAX_PER_HOUR=20

# ---------------------------------------------------------------- GDPR / firma ---
# Datele care apar in nota de informare de la /confidentialitate
OPERATOR_NAME=Firma Ta SRL
OPERATOR_CUI=RO12345678
OPERATOR_ADDRESS=Str. Exemplu 1, Bucuresti
OPERATOR_EMAIL=contact@firma-ta.ro
OPERATOR_PHONE=0721234567
# Responsabil cu protectia datelor, daca ai unul
DPO_EMAIL=

# Cate luni pastram datele care identifica o persoana (dupa aceea, doar statistica)
DATA_RETENTION_MONTHS=24
